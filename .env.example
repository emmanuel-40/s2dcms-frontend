# Copy this file to .env.local for local overrides (Vite loads .env.local automatically).
# .env* files are git-ignored — never commit real values.

# Leave EMPTY for local development: requests then go to `/api` and the Vite dev
# server proxies them to http://localhost:8080 with the Cookie and X-XSRF-TOKEN
# headers intact (see vite.config.js).
VITE_API_BASE_URL=

# Production: set this in the Vercel project's Environment Variables, not here.
# VITE_API_BASE_URL=https://s2dcms-backend.onrender.com
# The backend CORS allowlist must contain the exact deployed frontend origin.